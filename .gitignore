# ==========================================================================
#  SECRETS — real production data. NEVER commit or push these.
# ==========================================================================
# Live router credentials (~60 routers: IPs, admin/router passwords)
mikhmon/include/config.php
# Notification tokens (Telegram/WhatsApp) if configured at runtime
# mikhmon/include/notify_config.php   # currently empty defaults — review before pushing
# Server env: admin password + cron token
.env
# Router list exported for transfer to the server (same secrets as config.php)
config.local.php

# ==========================================================================
#  Runtime-generated data (per-deployment, may contain customer data)
# ==========================================================================
mikhmon/share/logs/
mikhmon/share/tickets/*.pdf
# keep the guard index files
!mikhmon/share/tickets/index.php

# ==========================================================================
#  Bundled binaries / runtime (not source code)
# ==========================================================================
php8/
lanceur.exe
*.exe

# ==========================================================================
#  Outillage local (specifique a la machine, pas au projet)
# ==========================================================================
# Configurations de lancement de l'agent: elles pointent vers php8/, qui est
# lui-meme ignore, et vers des dossiers temporaires propres a une session.
.claude/

# ==========================================================================
#  Noise
# ==========================================================================
*.log
.DS_Store
Thumbs.db
