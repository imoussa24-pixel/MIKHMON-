# TIKRAS IT — configuration serveur (copier vers .env a la racine du projet)

# Compte admin du panneau (OBLIGATOIRE: le login vide est refuse)
TIKRAS_ADMIN_USER=admin
TIKRAS_ADMIN_PASS=CHANGEZ-MOI

# Jeton du cron externe/interne (generer: openssl rand -hex 24)
TIKRAS_CRON_TOKEN=CHANGEZ-MOI

# Port HTTP publie par le VPS (80 par defaut; 8080 si Caddy en mode https)
TIKRAS_HTTP_PORT=80

# Interface d'ecoute. 0.0.0.0 expose le panneau sur l'IP publique du VPS, en
# HTTP clair. Avec le tunnel Cloudflare ci-dessous, mettre 127.0.0.1 (et le
# port a 8080) : l'exterieur ne passe plus que par le domaine, et la boucle
# locale ne sert qu'au diagnostic depuis un tunnel ssh.
TIKRAS_HTTP_ADRESSE=0.0.0.0

# Jeton du tunnel Cloudflare (profil "cloudflare"). Se recupere a la creation
# du tunnel dans le tableau de bord Zero Trust. Le nom d'hote public doit
# pointer vers http://app:80 — l'adresse interne du conteneur, prefixe
# http:// compris. Laisser vide desactive simplement le profil.
CLOUDFLARE_TUNNEL_TOKEN=

# Domaine pour HTTPS automatique via Caddy (profil https), ex: panel.tikras.net
# Inutile si l'acces public passe par le tunnel Cloudflare : Cloudflare fournit
# alors le certificat, et le profil https n'a pas a etre active.
TIKRAS_DOMAIN=

# Fuseau horaire
TZ=Africa/Niamey

# Cadences des automatisations (secondes, 0 = desactive)
TIKRAS_AUTO_HEALTH_INTERVAL=300
TIKRAS_AUTO_HEALTH_BATCH=30
TIKRAS_AUTO_ROAMING_INTERVAL=600
TIKRAS_AUTO_BACKUP_INTERVAL=86400
TIKRAS_AUTO_BACKUP_KEEP=10
TIKRAS_AUTO_SYNC_INTERVAL=3600
TIKRAS_AUTO_PRUNE_INTERVAL=604800
TIKRAS_AUTO_NOTIFY_DOWN=1
